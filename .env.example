# Credenciales de ejemplo para el scanner. Copia este archivo a '.env' y
# rellena los valores reales. '.env' esta ignorado por git (nunca se sube).
IQ_EMAIL=tu_correo@dominio.com
IQ_PASSWORD=tu_contraseña
IQ_ACCOUNT_TYPE=PRACTICE

# Puente WhatsApp local (opcional)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8120
WHATSAPP_BRIDGE_ENABLED=1
