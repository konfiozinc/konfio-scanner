# Credenciales de ejemplo para el scanner. Copia este archivo a '.env' y
# rellena los valores reales. '.env' esta ignorado por git (nunca se sube).
IQ_EMAIL=tu_correo@dominio.com
IQ_PASSWORD=tu_contraseña
IQ_ACCOUNT_TYPE=PRACTICE

# --- Control de acceso al panel (opcional pero recomendado) ---
# El servidor escucha en 0.0.0.0. SIN este token, cualquiera en tu misma red
# puede abrir http://<tu-ip>:8000/ y ver las senales. Con el token puesto, las
# peticiones de otros equipos necesitan ?token=... o la cabecera X-Auth-Token.
# Desde tu propio equipo (127.0.0.1) siempre funciona, aunque olvides el token.
# Genera una cadena larga y aleatoria, por ejemplo:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Dejalo vacio (o comenta la linea) para desactivar el control.
WS_AUTH_TOKEN=

# ------------------------------------------------------------------
# Ali Binary Options - publicacion de senales en la app
# ------------------------------------------------------------------
# Opcion A (RECOMENDADA): Cloud Function 'postSignal'.
# El scanner hace POST aqui y la funcion escribe en Firestore. Ventaja: la
# service account NO vive en el scanner.
APP_SIGNAL_URL=
# Secreto compartido con la Cloud Function (cadena larga y aleatoria).
APP_SIGNAL_SECRET=CAMBIA_ESTE_SECRETO

# Opcion B (alternativa): escritura directa en Firestore con service account.
# Si usas esta via, deja APP_SIGNAL_URL vacio y rellena FIREBASE_SA_PATH.
FIREBASE_SA_PATH=
FIREBASE_PROJECT_ID=ali-binary-options

# --- Ajustes finos (todos con valor por defecto sensato) ---
# MAX_UNIVERSE=40              # tope de activos vigilados
# MARKET_REFRESH_INTERVAL=60   # cada cuanto se revalida el universo (s)
# STALE_TOLERANCE=3            # avisos seguidos de vela atrasada antes de cerrar
# INDICATORS_ENGINE=numpy      # numpy | ta (ta = implementacion original)
# BODY_OUTSIDE_OTC=40          # umbral OTC; 55 lo endurece (decision de trading)
# VOLUME_FILTER_ENABLED=0      # en OTC el volumen es 0; en REAL si hay dato
# ENABLE_ALERTS=1              # 0 = no publicar ninguna senal en la app
# LOG_MAX_BYTES=10485760       # tamano de scanner.log antes de rotar
# LOG_BACKUPS=5                # copias de scanner.log que se conservan
